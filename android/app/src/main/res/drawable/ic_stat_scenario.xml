<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar / notification small icon: the centre mark of the Scenario logo
  (the outlined speech bubble holding a "…" chat bubble), reduced to a single
  colour. Android draws a small icon from its alpha channel only and tints it
  itself, so a full-colour launcher icon renders as a white blob there — this
  is the shape-only version. Used by the app's own notifications and, through
  the manifest's FCM default_notification_icon, by pushes the OS draws.
-->
