    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Outer speech bubble, as a ring: outer outline minus an inset hole. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M9,2H15A7,7 0,0 1,22 9V13A7,7 0,0 1,15 20H9.5L5.2,23.2C4.7,23.6 4,23.2 4,22.6V18.4A7,7 0,0 1,2 13V9A7,7 0,0 1,9 2Z
