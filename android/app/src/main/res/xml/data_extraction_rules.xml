<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (`android:dataExtractionRules`).

  Two independent channels, and both have to be closed:

  * cloud-backup   — Google's automatic backup to the user's Drive.
  * device-transfer — the direct device-to-device copy during setup of a new
                      phone. This one is easy to miss: it is NOT covered by
                      the cloud-backup block and has its own section.

  As with backup_rules.xml, `android:allowBackup="false"` is the primary
  control; this exists so the exclusions survive that flag being changed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path=".cookies/" />
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path=".cookies/" />
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
