# Copy to `android/key.properties` and fill in. NEVER commit the real file:
# it is git-ignored, and the values in it are what prove a build is ours.
#
# Generate a keystore once, then keep it somewhere durable and backed up —
# losing it means the app can never be updated under the same identity again:
#
#   keytool -genkey -v -keystore scenario-release.jks \
#           -keyalg RSA -keysize 4096 -validity 10000 -alias scenario
#
storeFile=/absolute/path/to/scenario-release.jks
storePassword=
keyAlias=scenario
keyPassword=
