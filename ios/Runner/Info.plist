<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Scenario Mobile</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>scenario_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Matches AppLocalizations.supportedLocales / l10n.yaml — the app picks
	     the active locale itself (Settings toggle), but declaring this lets
	     iOS list Arabic under the app's own language setting too. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
	</array>
	<!-- Lets a push wake the app to sync in the background; required for FCM
	     background/killed delivery (NOTIFICATIONS_INTEGRATION.md §4). The
	     "Push Notifications" capability itself still has to be enabled on the
	     Runner target in Xcode — that isn't a plist edit. -->
	<!-- App Transport Security, stated explicitly rather than left to the
	     default. ATS already denies cleartext HTTP unless an exception is
	     declared, so this changes nothing at runtime — it is here so that the
	     absence of an exception is a visible, reviewable fact rather than
	     something a reader has to infer, and so that adding one later is an
	     obvious diff rather than a new key nobody notices.

	     NSAllowsArbitraryLoads must stay false. Every endpoint this app talks
	     to is HTTPS/WSS; Environment forces TLS in release builds, and a
	     development build wanting plaintext should point at a debug build's
	     own host, not weaken the shipped binary's transport policy. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<!-- Composer attachments (image_picker, record). iOS shows this text on
	     the system permission prompt, which only appears the moment the
	     agent taps the attachment button (camera/gallery) or the microphone
	     button — never at launch. -->
	<key>NSCameraUsageDescription</key>
	<string>Scenario needs camera access so you can take a photo to send in a conversation.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Scenario needs photo library access so you can attach an image to a conversation.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Scenario needs microphone access so you can record a voice message to send in a conversation.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
